let completed = JSON.parse(localStorage.getItem("aa_completed") || "[]");

const $ = id => document.getElementById(id);

function renderList(){
  const list = $("lessonList");
  list.innerHTML = "";
  let lastSection = "";
  lessons.forEach((l,i)=>{
    const section = i < 15 ? "1-bo‘lim" : "2-bo‘lim";
    if(section !== lastSection){
      const s=document.createElement("div");
      s.className="section-title";
      s.textContent=section;
      list.appendChild(s);
      lastSection=section;
    }
    const b=document.createElement("button");
    b.className="lesson"+(i===current?" active ":"")+(completed.includes(i)?" done":"");
    b.textContent=(i+1)+". "+l.title;
    b.onclick=()=>showLesson(i);
    list.appendChild(b);
  });
}

function showLesson(i){
  current=i;
  localStorage.setItem("aa_current",current);
  const l=lessons[i];

  $("lessonNumber").textContent=(i+1)+"-dars"+(l.time?" • "+l.time:"");
  $("title").textContent=l.title;
  $("theory").innerHTML="<p>"+l.theory+"</p>";
  $("components").innerHTML=l.components.map(x=>`<span class="chip">${x}</span>`).join("");
  $("code").textContent=l.code;
  $("modelInfo").textContent="Model: "+l.model+" — sichqoncha bilan aylantirish mumkin.";
  $("prevBtn").disabled=i===0;
  $("nextBtn").disabled=i===lessons.length-1;
  $("completeBtn").textContent=completed.includes(i)?"Dars tugallangan ✓":"Darsni tugatdim ✓";

  renderQuiz(l);
  renderList();
  renderProgress();
  make3D(l.model);
  window.scrollTo({top:0,behavior:"smooth"});
}

function renderQuiz(l){
  $("quizResult").textContent="";
  $("quiz").innerHTML="<p><b>"+l.q+"</b></p>"+
    l.opts.map((o,i)=>`<label><input type="radio" name="q" value="${i}"> ${o}</label>`).join("");
}

function checkQuiz(){
  const l=lessons[current];
  const selected=document.querySelector('input[name="q"]:checked');
  if(!selected){$("quizResult").textContent="Variantni tanlang.";return;}
  if(Number(selected.value)===l.a){
    $("quizResult").textContent="To‘g‘ri! ✓";
  }else{
    $("quizResult").textContent="Noto‘g‘ri. Darsni yana bir marta ko‘rib chiqing.";
  }
}

function completeLesson(){
  if(!completed.includes(current)) completed.push(current);
  localStorage.setItem("aa_completed",JSON.stringify(completed));
  showLesson(current);
}

function nextLesson(){if(current<lessons.length-1)showLesson(current+1)}
function prevLesson(){if(current>0)showLesson(current-1)}

function renderProgress(){
  const percent=Math.round(completed.length/lessons.length*100);
  $("progressBar").style.width=percent+"%";
  $("progressText").textContent=percent+"%";
}

async function copyCode(){
  try{
    await navigator.clipboard.writeText(lessons[current].code);
    const b=document.querySelector(".copy");
    b.textContent="Nusxalandi ✓";
    setTimeout(()=>b.textContent="Nusxalash",1200);
  }catch(e){alert("Kod nusxalanmadi. Qo‘lda belgilang.");}
}

let scene,camera,renderer,object,drag=false,lastX=0;

function make3D(type){
  const container=$("scene");
  container.innerHTML="";
  scene=new THREE.Scene();
  camera=new THREE.PerspectiveCamera(45,container.clientWidth/container.clientHeight,.1,100);
  camera.position.set(0,1.8,5.5);

  renderer=new THREE.WebGLRenderer({antialias:true});
  renderer.setSize(container.clientWidth,container.clientHeight);
  renderer.setPixelRatio(Math.min(devicePixelRatio,2));
  container.appendChild(renderer.domElement);

  scene.add(new THREE.AmbientLight(0xffffff,1.5));
  const light=new THREE.DirectionalLight(0xffffff,2);
  light.position.set(3,5,4); scene.add(light);

  const group=new THREE.Group();
  object=group;
  scene.add(group);

  const mat=(color,metal=0)=>new THREE.MeshStandardMaterial({color,metalness:metal,roughness:.45});

  if(type==="led"){
    const base=new THREE.Mesh(new THREE.CylinderGeometry(.65,.65,.18,32),mat(0x20252f));
    const bulb=new THREE.Mesh(new THREE.SphereGeometry(.42,32,20),mat(0xff3333));
    bulb.position.y=.5; group.add(base,bulb);
  }else if(type==="traffic"){
    const box=new THREE.Mesh(new THREE.BoxGeometry(1.1,2.7,.6),mat(0x252a34));
    group.add(box);
    [0.75,0,-.75].forEach((y,j)=>{
      const c=[0xff3333,0xffcc33,0x33dd66][j];
      const m=new THREE.Mesh(new THREE.SphereGeometry(.27,24,16),mat(c));
      m.position.set(0,y,.36); group.add(m);
    });
  }else if(type==="segment"){
    const base=new THREE.Mesh(new THREE.BoxGeometry(1.8,.35,.35),mat(0x1e293b));
    group.add(base);
    for(let i=0;i<7;i++){
      const m=new THREE.Mesh(new THREE.BoxGeometry(.55,.08,.08),mat(0xff5533));
      const a=[[-.25,.55],[.25,.55],[-.25,0],[.25,0],[-.25,-.55],[.25,-.55],[0,0]][i];
      m.position.set(a[0],a[1],.2);
      if(i===6)m.rotation.z=Math.PI/2;
      group.add(m);
    }
  }else if(type==="lcd"){
    const body=new THREE.Mesh(new THREE.BoxGeometry(2.8,1.2,.35),mat(0x1f2937));
    const screen=new THREE.Mesh(new THREE.BoxGeometry(2.35,.7,.08),mat(0x69b36d));
    screen.position.z=.22; group.add(body,screen);
  }else if(type==="servo"){
    const body=new THREE.Mesh(new THREE.BoxGeometry(1.5,1.2,1),mat(0x3b82f6));
    const horn=new THREE.Mesh(new THREE.BoxGeometry(.2,1.5,.15),mat(0xe5e7eb,0.3));
    horn.position.y=.75; group.add(body,horn);
  }else if(type==="buzzer"){
    const b=new THREE.Mesh(new THREE.CylinderGeometry(.65,.65,.5,32),mat(0x111827));
    group.add(b);
  }else if(type==="button"){
    const base=new THREE.Mesh(new THREE.BoxGeometry(1.2,.35,1.2),mat(0x1f2937));
    const top=new THREE.Mesh(new THREE.CylinderGeometry(.35,.35,.35,24),mat(0xef4444));
    top.position.y=.35; group.add(base,top);
  }else if(type==="sensor" || type==="ldr" || type==="ir"){
    const base=new THREE.Mesh(new THREE.BoxGeometry(2,.25,1),mat(0x166534));
    const head=new THREE.Mesh(new THREE.CylinderGeometry(.3,.3,.45,24),mat(type==="ldr"?0x94a3b8:0x111827));
    head.rotation.x=Math.PI/2; head.position.y=.25; group.add(base,head);
  }else if(type==="relay"){
    const board=new THREE.Mesh(new THREE.BoxGeometry(2.2,.18,1.4),mat(0x166534));
    const block=new THREE.Mesh(new THREE.BoxGeometry(1.1,.75,.8),mat(0x1f2937));
    block.position.y=.45; group.add(board,block);
  }else if(type==="arduino" || type==="board"){
    const board=new THREE.Mesh(new THREE.BoxGeometry(3.2,.15,2.1),mat(0x16734a));
    group.add(board);
    const chip=new THREE.Mesh(new THREE.BoxGeometry(.8,.12,.55),mat(0x111827));
    chip.position.y=.15; group.add(chip);
    for(let i=0;i<10;i++){
      const pin=new THREE.Mesh(new THREE.BoxGeometry(.08,.3,.08),mat(0xd4af37,0.6));
      pin.position.set(-1.25+i*.28,.15,-1.08); group.add(pin);
    }
  }else if(type==="rgb"){
    const base=new THREE.Mesh(new THREE.CylinderGeometry(.5,.5,.2,32),mat(0x1f2937));
    const bulb=new THREE.Mesh(new THREE.SphereGeometry(.4,24,16),mat(0x60a5fa));
    bulb.position.y=.45; group.add(base,bulb);
  }else if(type==="chip" || type==="logic" || type==="flow"){
    const chip=new THREE.Mesh(new THREE.BoxGeometry(2,.35,1.1),mat(0x111827));
    group.add(chip);
    for(let i=0;i<6;i++){
      const p=new THREE.Mesh(new THREE.BoxGeometry(.08,.3,.08),mat(0xd4af37,0.5));
      p.position.set(-.75+i*.3,.1,-.65);group.add(p);
    }
  }else if(type==="piano"){
    for(let i=0;i<7;i++){
      const key=new THREE.Mesh(new THREE.BoxGeometry(.35,.15,1.2),mat(0xf8fafc));
      key.position.x=(i-3)*.38; group.add(key);
    }
    const buzz=new THREE.Mesh(new THREE.CylinderGeometry(.35,.35,.25,24),mat(0x111827));
    buzz.position.y=.25; group.add(buzz);
  }else if(type==="loop"){
    const torus=new THREE.Mesh(new THREE.TorusGeometry(.9,.18,16,48),mat(0x60a5fa,0.2));
    group.add(torus);
  }else if(type==="quiz"){
    const box=new THREE.Mesh(new THREE.BoxGeometry(2.2,1.2,.6),mat(0x2563eb));
    group.add(box);
  }else{
    const box=new THREE.Mesh(new THREE.BoxGeometry(2,1,1),mat(0x334155));
    group.add(box);
  }

  container.onmousedown=e=>{drag=true;lastX=e.clientX}
  window.onmouseup=()=>drag=false;
  window.onmousemove=e=>{if(drag&&object){object.rotation.y+=(e.clientX-lastX)*.01;lastX=e.clientX}}
  animate();
}

function animate(){
  if(!renderer)return;
  requestAnimationFrame(animate);
  if(object&&!drag)object.rotation.y+=.005;
  renderer.render(scene,camera);
}

$("year").textContent=new Date().getFullYear();
showLesson(current);
</script>
</body>
</html>
